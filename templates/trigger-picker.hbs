<div class="pf2e-reminders-picker">
    <nav class="tabs">
        {{#each groups}}
            <button type="button" class="{{#if active}}active pf2e-reminders-has-choice{{/if}}" data-action="tab" data-group="triggers" data-tab="{{id}}">{{label}}</button>
        {{/each}}
    </nav>
    {{#each groups}}
        <div class="tab{{#if active}} active{{/if}}" data-group="triggers" data-tab="{{id}}">
            {{#each sections}}
                {{#if label}}<h4 class="pf2e-reminders-subgroup">{{label}}</h4>{{/if}}
                <div class="pf2e-reminders-choices">
                    {{#each triggers}}
                        <label class="pf2e-reminders-choice">
                            <input type="radio" name="trigger" value="{{id}}"{{#if selected}} checked{{/if}}>
                            <span>{{label}}</span>
                            <i class="{{icon}} fa-fw"></i>
                        </label>
                    {{/each}}
                </div>
            {{/each}}
        </div>
    {{/each}}
</div>
