<h4 class="pf2e-reminders-title">
    <span>{{localize "REMINDERS.chat.title"}}</span>
    {{#if hasActor}}
        <span class="pf2e-reminders-buttons">
            {{#if showList}}<a data-action="openReminders" data-tooltip="{{localize "REMINDERS.chat.showAll"}}"><i class="fa-solid fa-fw fa-bell"></i></a>{{/if}}
            {{#if showToggle}}<a data-action="toggleEnabled" data-toggle-actor><i class="fa-solid fa-fw fa-toggle-on"></i></a>{{/if}}
            <a data-action="addCustom" data-tooltip="{{localize "REMINDERS.chat.custom"}}"><i class="fa-solid fa-fw fa-plus"></i></a>
        </span>
    {{/if}}
</h4>
{{#if triggerIcon}}
<p class="pf2e-reminders-subheader"><i class="{{triggerIcon}} fa-fw"></i> {{triggerLabel}}</p>
{{/if}}
